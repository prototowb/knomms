# Knowledge Commons — environment variables
# Copy this to .env and fill in the required values.
# Never commit .env to version control.

# ── Required secrets ─────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password
MINIO_ROOT_PASSWORD=change-me-strong-password
SECRET_KEY=change-me-at-least-32-random-chars

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=kc
# DATABASE_URL and DATABASE_SYNC_URL are constructed by docker-compose.yml
# from the above values — do not set them here unless overriding.

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=kc-admin

# ── Ollama (not required for Milestone 0) ────────────────────────────────────
# Tier options (see docs/02-ai-architecture.md §3.5):
#   GPU 24GB:  mistral:7b-instruct   or  llama3:70b-instruct-q4_K_M
#   GPU 8GB:   mistral:7b-instruct
#   CPU-only:  phi3:mini-instruct-q4_K_M
OLLAMA_MODEL=mistral:7b-instruct

# ── Application ───────────────────────────────────────────────────────────────
MAX_CONCURRENT_GENERATIONS=2
# Retrieval chunks per Q&A query.
# CPU default=3 (~1200 input tokens, ~2min TTFT on 4 cores).
# Set to 10 for GPU deployments where prefill is fast (<1s).
RETRIEVAL_TOP_K=3
# Ollama generation read timeout (seconds).
# CPU needs ~120s prefill for a 1200-token context; 300s gives headroom.
# GPU deployments can use 60.
OLLAMA_READ_TIMEOUT=300
HTTP_PORT=80
NODE_ENV=production
